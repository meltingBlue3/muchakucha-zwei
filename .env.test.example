# Local test-only values. Copy to .env.test; never put production credentials here.
NODE_ENV=test

# Exact local browser/API origins.
WEB_ORIGIN=http://127.0.0.1:8081
API_ORIGIN=http://127.0.0.1:3000

# Isolated test PostgreSQL container. These values are not production secrets.
TEST_POSTGRES_DB=muchakucha_test
TEST_POSTGRES_USER=muchakucha_test
TEST_POSTGRES_PASSWORD=muchakucha_test_only
TEST_POSTGRES_PORT=55432
DATABASE_URL=postgresql://muchakucha_test:muchakucha_test_only@127.0.0.1:55432/muchakucha_test

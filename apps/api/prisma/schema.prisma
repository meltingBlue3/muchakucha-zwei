generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String                   @db.VarChar(320)
  emailCanonical      String                   @unique(map: "User_email_canonical_key") @map("email_canonical") @db.VarChar(320)
  displayName         String                   @map("display_name") @db.VarChar(80)
  passwordHash        String                   @map("password_hash") @db.Text
  emailVerifiedAt     DateTime?                @map("email_verified_at") @db.Timestamptz(3)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions            AuthSession[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  memberships         Membership[]
  sentInvitations     Invitation[]
  createdEvents       Event[]
  createdTasks        Task[]          @relation("CreatedTasks")
  createdRecurrenceRules RecurrenceRule[] @relation("CreatedRecurrenceRules")
  taskAssignments     TaskAssignee[]
  createdNotes        Note[]
  createdLabels       Label[]
}

model Household {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String       @db.VarChar(40)
  ownerMembershipId String?      @unique(map: "Household_owner_membership_id_key") @map("owner_membership_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships       Membership[]
  invitations       Invitation[]
  events            Event[]
  tasks             Task[]
  recurrenceRules   RecurrenceRule[]
  notes             Note[]
  labels            Label[]
  ownerMembership   Membership?  @relation("HouseholdOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)

  @@map("households")
}

model Membership {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  householdId  String     @map("household_id") @db.Uuid
  role         String     @db.VarChar(10)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  household    Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ownedHousehold Household? @relation("HouseholdOwner")
  sentInvitations  Invitation[]

  @@unique([userId, householdId], map: "Membership_user_id_household_id_key")
  @@index([householdId, role], map: "Membership_household_id_role_idx")
  @@map("memberships")
}

model Invitation {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inviterUserId       String     @map("inviter_user_id") @db.Uuid
  inviterMembershipId String     @map("inviter_membership_id") @db.Uuid
  householdId         String     @map("household_id") @db.Uuid
  emailCanonical      String     @map("email_canonical") @db.VarChar(320)
  hash                String     @unique @db.Char(64)
  role                String     @default("MEMBER") @db.VarChar(10)
  expiresAt           DateTime   @map("expires_at") @db.Timestamptz(3)
  invalidatedAt       DateTime?  @map("invalidated_at") @db.Timestamptz(3)
  consumedAt          DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  inviterUser         User       @relation(fields: [inviterUserId], references: [id], onDelete: Cascade)
  inviterMembership   Membership @relation(fields: [inviterMembershipId], references: [id], onDelete: Cascade)
  household           Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, emailCanonical, invalidatedAt, consumedAt], map: "Invitation_household_email_state_idx")
  @@map("invitations")
}

model AuthSession {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  absoluteEndsAt DateTime       @map("absolute_ends_at") @db.Timestamptz(3)
  revokedAt      DateTime?      @map("revoked_at") @db.Timestamptz(3)
  compromisedAt  DateTime?      @map("compromised_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt     DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens  RefreshToken[]

  @@index([userId, revokedAt], map: "AuthSession_user_id_revoked_at_idx")
}

model RefreshToken {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String        @map("session_id") @db.Uuid
  tokenHash  String        @unique(map: "RefreshToken_token_hash_key") @map("token_hash") @db.Char(64)
  parentId   String?       @unique(map: "RefreshToken_parent_id_key") @map("parent_id") @db.Uuid
  expiresAt  DateTime      @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?     @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  session    AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parent     RefreshToken? @relation("RefreshChain", fields: [parentId], references: [id], onDelete: SetNull)
  child      RefreshToken? @relation("RefreshChain")

  @@index([sessionId, consumedAt], map: "RefreshToken_session_id_consumed_at_idx")
}

model EmailVerificationToken {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique(map: "EmailVerificationToken_token_hash_key") @map("token_hash") @db.Char(64)
  pendingProofHash String?   @unique(map: "EmailVerificationToken_pending_proof_hash_key") @map("pending_proof_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt    DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, invalidatedAt], map: "EmailVerificationToken_user_state_idx")
}

model Event {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId String     @map("household_id") @db.Uuid
  title       String     @db.VarChar(200)
  description String?    @db.Text
  startTime   DateTime   @map("start_time") @db.Timestamptz(3)
  endTime     DateTime   @map("end_time") @db.Timestamptz(3)
  allDay      Boolean    @default(false) @map("all_day")
  location    String?    @db.VarChar(255)
  createdBy   String     @map("created_by") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  recurrenceRuleId String? @map("recurrence_rule_id") @db.Uuid
  occurrenceDate DateTime? @map("occurrence_date") @db.Date
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)

  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  creator     User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  labels      EventLabel[]
  recurrenceRule RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id], onDelete: SetNull)

  @@index([householdId, startTime], map: "Event_household_start_idx")
  @@index([householdId, endTime], map: "Event_household_end_idx")
  @@index([createdBy], map: "Event_created_by_idx")
  @@unique([recurrenceRuleId, occurrenceDate], map: "Event_rule_occurrence_key")
  @@map("events")
}

model Task {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId String     @map("household_id") @db.Uuid
  title       String     @db.VarChar(200)
  description String?    @db.Text
  status      String     @default("pending") @db.VarChar(20)
  priority    String     @default("medium") @db.VarChar(10)
  dueDate     DateTime?  @map("due_date") @db.Timestamptz(3)
  createdBy   String     @map("created_by") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  recurrenceRuleId String? @map("recurrence_rule_id") @db.Uuid
  occurrenceDate DateTime? @map("occurrence_date") @db.Date

  household   Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  creator     User           @relation("CreatedTasks", fields: [createdBy], references: [id], onDelete: Cascade)
  labels      TaskLabel[]
  assignees   TaskAssignee[]
  recurrenceRule RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id], onDelete: SetNull)

  @@index([householdId, status], map: "Task_household_status_idx")
  @@unique([recurrenceRuleId, occurrenceDate], map: "Task_rule_occurrence_key")
  @@map("tasks")
}

model RecurrenceRule {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId         String    @map("household_id") @db.Uuid
  freq                String    @db.VarChar(10)
  interval            Int       @default(1)
  byWeekday           Int[]     @map("by_weekday")
  startsOn            DateTime  @map("starts_on") @db.Date
  endsOn              DateTime? @map("ends_on") @db.Date
  count               Int?
  timezone            String    @db.VarChar(64)
  materializedThrough DateTime? @map("materialized_through") @db.Date
  startTimeLocal      String?   @map("start_time_local") @db.VarChar(5)
  durationMinutes     Int?      @map("duration_minutes")
  createdBy           String    @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  creator   User      @relation("CreatedRecurrenceRules", fields: [createdBy], references: [id], onDelete: Cascade)
  events    Event[]
  tasks     Task[]

  @@index([householdId], map: "RecurrenceRule_household_idx")
  @@index([materializedThrough], map: "RecurrenceRule_materialized_through_idx")
  @@map("recurrence_rules")
}

model PasswordResetToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique(map: "PasswordResetToken_token_hash_key") @map("token_hash") @db.Char(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, invalidatedAt], map: "PasswordResetToken_user_state_idx")
}

model Note {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId String    @map("household_id") @db.Uuid
  title       String    @db.VarChar(200)
  body        String?   @db.Text
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  creator     User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt(sort: Desc)], map: "Note_household_created_idx")
  @@map("notes")
}

model Label {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId String   @map("household_id") @db.Uuid
  name        String   @db.VarChar(40)
  color       String   @db.VarChar(7)
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  household   Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  creator     User           @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  eventLabels EventLabel[]
  taskLabels  TaskLabel[]

  @@unique([householdId, name], map: "Label_household_name_key")
  @@map("labels")
}

model EventLabel {
  eventId String @map("event_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([eventId, labelId])
  @@map("event_labels")
}

model TaskLabel {
  taskId  String @map("task_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

model TaskAssignee {
  taskId String @map("task_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId], map: "TaskAssignee_user_idx")
  @@map("task_assignees")
}

{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "prisma generate",
    "test": "vitest run",
    "test:quick": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "openapi:generate": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/modules/auth/data','dist/modules/auth/data',{recursive:true})\" && node dist/openapi/generate-openapi.js",
    "openapi:check": "pwsh -NoProfile -File ../../scripts/check-openapi-drift.ps1"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "nodemailer": "9.0.3",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.20.0",
    "prisma": "7.9.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}

# 本地开发模板：复制为同目录的 .env；已有 .env 时只补充缺少的配置。
# 示例数据库账号对应 README 的本地 PostgreSQL 设置，请按实际情况修改。
# 集成测试使用独立的可清空测试库，不要使用此开发库。
DATABASE_URL=postgresql://muchakucha_dev:muchakucha_dev_only@127.0.0.1:5432/muchakucha_dev

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# 真机访问时将 HOST 改为 0.0.0.0，并使用电脑的局域网地址连接。

# 本地开发可省略 JWT_ACCESS_SECRET，使用内置开发默认值。
# 生产环境必须配置独立的至少 32 字节密钥，不可使用开发默认值。
# JWT_ACCESS_SECRET=

# 启用 AI 助手前必须填写；留空时其他功能仍可运行。
# 生成命令：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 将命令输出粘贴到等号后。妥善备份，不要提交或随意替换，否则已有模型凭证无法解密。
ASSISTANT_ENCRYPTION_KEY=

# 可选：精确的 Web 来源，多个值用逗号分隔；第一个也用于邀请分享链接。
# 生产环境必须填写 HTTPS 来源，具体配置见 README 的生产部署章节。
# WEB_ORIGIN=http://localhost:8081

# 仅在反向代理后运行时设置可信代理 IP/CIDR；本地直连无需设置。
# TRUST_PROXY=127.0.0.1,::1

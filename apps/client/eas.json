{
  "cli": {
    "version": ">= 21.6.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "24.18.0",
      "pnpm": "10.34.5",
      "env": {
        "APP_VARIANT": "development"
      },
      "android": {
        "withoutCredentials": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://47.117.148.16"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://47.117.148.16"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

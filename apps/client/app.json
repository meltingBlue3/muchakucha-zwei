{
  "expo": {
    "name": "Muchakucha Zwei",
    "slug": "muchakucha-zwei",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "muchakucha-zwei",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "app.muchakucha.zwei"
    },
    "ios": {
      "bundleIdentifier": "app.muchakucha.zwei",
      "associatedDomains": []
    },
    "web": {
      "bundler": "metro"
    }
  }
}

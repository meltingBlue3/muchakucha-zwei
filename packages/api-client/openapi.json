{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "operationId": "register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationAcceptedDto"
                }
              }
            }
          },
          "400": {
            "description": "Registration input or transport is invalid."
          }
        },
        "summary": "",
        "tags": [
          "auth"
        ]
      }
    }
  },
  "info": {
    "title": "Muchakucha Zwei API",
    "description": "Versioned household collaboration API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "member@example.com",
            "maxLength": 320
          },
          "displayName": {
            "type": "string",
            "example": "Member",
            "maxLength": 80
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          },
          "platform": {
            "type": "string",
            "enum": [
              "native",
              "web"
            ]
          }
        },
        "required": [
          "email",
          "displayName",
          "password",
          "platform"
        ]
      },
      "RegistrationAcceptedDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "REGISTRATION_ACCEPTED"
            ]
          },
          "pendingProof": {
            "type": "string",
            "description": "Native-only pending proof for encrypted device storage."
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
}

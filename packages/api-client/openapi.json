  "info": {
    "title": "Muchakucha Zwei API",
    "description": "Versioned household collaboration API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CurrentUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "member@example.com"
          },
          "displayName": {
            "type": "string",
            "example": "Family member"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "hasHousehold": {
            "type": "boolean",
            "description": "Phase 1 handoff signal; household lookup begins in Phase 2."
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "emailVerified",
          "hasHousehold"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "example": "Family member",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "displayName"
        ]
      },
      "InvitationPreviewResponseDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "valid",
              "invalid",
              "expired",
              "used"
            ]
          },
          "householdName": {
            "type": "string",
            "example": "温暖小家",
            "description": "Only present when kind is \"valid\"."
          },
          "inviterDisplayName": {
            "type": "string",
            "example": "家主",
            "description": "Only present when kind is \"valid\"."
          },
          "expiresAt": {
            "type": "string",
            "description": "ISO 8601 expiry. Only present when kind is \"valid\"."
          }
        },
        "required": [
          "kind"
        ]
      },
      "AcceptInvitationDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The raw invitation token from the URL query parameter.",
            "example": "abc123def456"
          }
        },
        "required": [
          "token"
        ]
      },
      "GetHouseholdMemberDto": {
        "type": "object",
        "properties": {
          "membershipId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string",
            "example": "家主"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "owner@example.test"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "MEMBER"
            ]
          },
          "isCurrentUser": {
            "type": "boolean"
          }
        },
        "required": [
          "membershipId",
          "userId",
          "displayName",
          "email",
          "role",
          "isCurrentUser"
        ]
      },
      "GetHouseholdResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "温暖小家"
          },
          "ownerMembershipId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetHouseholdMemberDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "ownerMembershipId",
          "createdAt",
          "members"
        ]
      },
      "CreateHouseholdDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "My Family",
            "minLength": 1,
            "maxLength": 40,
            "description": "1–40 Unicode code points after trim and NFC normalization."
          }
        },
        "required": [
          "name"
        ]
      },
      "MembershipResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "householdId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "MEMBER"
            ]
          }
        },
        "required": [
          "id",
          "userId",
          "householdId",
          "role"
        ]
      },
      "CreateHouseholdResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "My Family"
          },
          "ownerMembershipId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string"
          },
          "membership": {
            "$ref": "#/components/schemas/MembershipResponseDto"
          }
        },
        "required": [
          "id",
          "name",
          "ownerMembershipId",
          "createdAt",
          "membership"
        ]
      },
      "ListMyHouseholdsItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "My Family"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "MEMBER"
            ]
          },
          "memberCount": {
            "type": "number",
            "example": 3
          },
          "ownerMembershipId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "memberCount",
          "ownerMembershipId"
        ]
      },
      "UpdateHouseholdDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "我们的家",
            "minLength": 1,
            "maxLength": 40,
            "description": "1–40 Unicode code points after trim and NFC normalization."
          }
        },
        "required": [
          "name"
        ]
      },
      "SendHouseholdInvitationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "friend@example.test",
            "description": "Canonical invited email address. Role is server-fixed to MEMBER per D-05."
          }
        },
        "required": [
          "email"
        ]
      },
      "SendHouseholdInvitationResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVITATION_SENT"
          },
          "message": {
            "type": "string",
            "example": "邀请已发送。"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "InvitationListItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "emailCanonical": {
            "type": "string",
            "format": "email",
            "example": "pending@example.test"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "expired",
              "accepted",
              "revoked"
            ]
          },
          "expiresAt": {
            "type": "string",
            "description": "ISO 8601 expiry timestamp."
          },
          "role": {
            "type": "string",
            "example": "MEMBER"
          },
          "createdAt": {
            "type": "string",
            "description": "ISO 8601 creation timestamp."
          }
        },
        "required": [
          "id",
          "emailCanonical",
          "status",
          "expiresAt",
          "role",
          "createdAt"
        ]
      },
      "ListInvitationsResponseDto": {
        "type": "object",
        "properties": {
          "invitations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvitationListItemDto"
            }
          }
        },
        "required": [
          "invitations"
        ]
      },
      "ResendInvitationResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVITATION_RESENT"
          },
          "message": {
            "type": "string",
            "example": "邀请已重新发送。"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "RevokeInvitationResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVITATION_REVOKED"
          },
          "message": {
            "type": "string",
            "example": "邀请已撤销。"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ChangeMemberRoleDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "MEMBER"
            ],
            "description": "Target role. OWNER is never a valid DTO value - ownership transfer uses a separate endpoint.",
            "example": "ADMIN"
          }
        },
        "required": [
          "role"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "member@example.com",
            "maxLength": 320
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true
          },
          "platform": {
            "type": "string",
            "enum": [
              "native",
              "web"
            ]
          }
        },
        "required": [
          "email",
          "password",
          "platform"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string",
            "description": "Native-only refresh credential. Web responses omit this property."
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Native-only opaque refresh credential.",
            "minLength": 1
          }
        }
      },
      "RefreshResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string",
            "description": "Native-only rotated refresh credential. Web responses omit this property."
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "member@example.com",
            "maxLength": 320
          },
          "displayName": {
            "type": "string",
            "example": "Member",
            "maxLength": 80
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          },
          "platform": {
            "type": "string",
            "enum": [
              "native",
              "web"
            ]
          }
        },
        "required": [
          "email",
          "displayName",
          "password",
          "platform"
        ]
      },
      "RegistrationAcceptedDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "REGISTRATION_ACCEPTED"
            ]
          },
          "pendingProof": {
            "type": "string",
            "description": "Native-only pending proof for encrypted device storage."
          }
        },
        "required": [
          "code"
        ]
      },
      "CompleteEmailVerificationDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "writeOnly": true
          },
          "platform": {
            "type": "string",
            "enum": [
              "native"
            ]
          },
          "pendingProof": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "writeOnly": true
          }
        },
        "required": [
          "token"
        ]
      },
      "CompleteEmailVerificationResponseDto": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "verified_auto_login",
              "verified_login_required",
              "expired",
              "used",
              "invalid",
              "superseded"
            ]
          },
          "accessToken": {
            "type": "string",
            "description": "Short-lived access credential issued only for same-device success."
          },
          "refreshToken": {
            "type": "string",
            "description": "Native-only refresh credential for encrypted device storage."
          }
        },
        "required": [
          "outcome"
        ]
      },
      "ResendEmailVerificationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "member@example.com",
            "maxLength": 320
          }
        },
        "required": [
          "email"
        ]
      },
      "ResendEmailVerificationResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "RESEND_ACCEPTED"
            ]
          },
          "retryAfterSeconds": {
            "type": "number",
            "example": 60,
            "minimum": 1
          }
        },
        "required": [
          "code",
          "retryAfterSeconds"
        ]
      },
      "RequestPasswordResetDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "member@example.com",
            "maxLength": 320
          }
        },
        "required": [
          "email"
        ]
      },
      "PasswordResetRequestAcceptedDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "PASSWORD_RESET_REQUEST_ACCEPTED"
            ]
          }
        },
        "required": [
          "code"
        ]
      },
      "CompletePasswordResetDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "writeOnly": true
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "token",
          "password"
        ]
      }
    }
  }
}

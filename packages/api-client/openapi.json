  "info": {
    "title": "Muchakucha Zwei API",
    "description": "Versioned household collaboration API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CurrentUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "member@example.com"
          },
          "displayName": {
            "type": "string",
            "example": "Family member"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "hasHousehold": {
            "type": "boolean",
            "description": "Phase 1 handoff signal; household lookup begins in Phase 2."
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "emailVerified",
          "hasHousehold"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "example": "Family member",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "displayName"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "member@example.com",
            "maxLength": 320
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true
          },
          "platform": {
            "type": "string",
            "enum": [
              "native",
              "web"
            ]
          }
        },
        "required": [
          "email",
          "password",
          "platform"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string",
            "description": "Native-only refresh credential. Web responses omit this property."
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Native-only opaque refresh credential.",
            "minLength": 1
          }
        }
      },
      "RefreshResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string",
            "description": "Native-only rotated refresh credential. Web responses omit this property."
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "member@example.com",
            "maxLength": 320
          },
          "displayName": {
            "type": "string",
            "example": "Member",
            "maxLength": 80
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          },
          "platform": {
            "type": "string",
            "enum": [
              "native",
              "web"
            ]
          }
        },
        "required": [
          "email",
          "displayName",
          "password",
          "platform"
        ]
      },
      "RegistrationAcceptedDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "REGISTRATION_ACCEPTED"
            ]
          },
          "pendingProof": {
            "type": "string",
            "description": "Native-only pending proof for encrypted device storage."
          }
        },
        "required": [
          "code"
        ]
      },
      "CompleteEmailVerificationDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "writeOnly": true
          },
          "platform": {
            "type": "string",
            "enum": [
              "native"
            ]
          },
          "pendingProof": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "writeOnly": true
          }
        },
        "required": [
          "token"
        ]
      },
      "CompleteEmailVerificationResponseDto": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "verified_auto_login",
              "verified_login_required",
              "expired",
              "used",
              "invalid",
              "superseded"
            ]
          },
          "accessToken": {
            "type": "string",
            "description": "Short-lived access credential issued only for same-device success."
          },
          "refreshToken": {
            "type": "string",
            "description": "Native-only refresh credential for encrypted device storage."
          }
        },
        "required": [
          "outcome"
        ]
      },
      "ResendEmailVerificationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "member@example.com",
            "maxLength": 320
          }
        },
        "required": [
          "email"
        ]
      },
      "ResendEmailVerificationResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "RESEND_ACCEPTED"
            ]
          },
          "retryAfterSeconds": {
            "type": "number",
            "example": 60,
            "minimum": 1
          }
        },
        "required": [
          "code",
          "retryAfterSeconds"
        ]
      },
      "RequestPasswordResetDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "member@example.com",
            "maxLength": 320
          }
        },
        "required": [
          "email"
        ]
      },
      "PasswordResetRequestAcceptedDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "PASSWORD_RESET_REQUEST_ACCEPTED"
            ]
          }
        },
        "required": [
          "code"
        ]
      },
      "CompletePasswordResetDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "writeOnly": true
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "token",
          "password"
        ]
      }
    }
  }
}
